{
  "name": "orca-agent-pipeline",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "orca plugin test . --json",
    "check": "orca plugin check . --json",
    "validate": "orca plugin validate . --json",
    "build:release": "node scripts/build-release.mjs",
    "test:release": "node --test scripts/build-release.test.mjs",
    "build:terminal": "node scripts/build-terminal.mjs",
    "typecheck:terminal": "tsc -p tsconfig.terminal.json",
    "test:terminal": "node --import tsx --test packages/**/*.spec.ts",
    "pipeline": "node bin/pipeline.mjs",
    "pretest:terminal": "npm run build:terminal",
    "prepack": "npm run typecheck:terminal && npm run build:terminal"
  },
  "devDependencies": {
    "@beads/bd": "^1.3.2",
    "@types/node": "^22.0.0",
    "esbuild": "0.25.12",
    "tsx": "4.22.4",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  },
  "description": "Orca agent DAG workflows with a visual planner, Beads tracking and quota-aware failover",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "orca-plugin",
    "agents",
    "workflow",
    "beads"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alexander-64/orca-pipeline.git"
  },
  "homepage": "https://github.com/Alexander-64/orca-pipeline",
  "bugs": {
    "url": "https://github.com/Alexander-64/orca-pipeline/issues"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "typebox": "1.3.27"
  },
  "bin": {
    "pipeline": "bin/pipeline.mjs"
  },
  "files": [
    "bin",
    "dist/terminal",
    "README.md",
    "README.ru.md",
    "docs/release-0.4.0.md",
    "docs/release-0.4.0.ru.md",
    "LICENSE",
    "docs/terminal-agent-implementation-plan.md",
    "scripts/e2e-*.mjs"
  ]
}
